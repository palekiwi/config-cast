{
  "nix_version": "2.34.6",
  "sandbox_shell": "~/.config/cast/nix",
  "env_passthrough": [
    "ANTHROPIC_API_KEY",
    "CONTEXT7_API_KEY",
    "GEMINI_API_KEY",
    "GH_TOKEN_READONLY",
    "JIRA_BOARD_ID",
    "JIRA_EMAIL",
    "JIRA_PROJECT",
    "JIRA_TOKEN_READONLY",
    "JIRA_URL",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "OPENCODE_API_KEY",
    "OPENCODE_CONFIG_DIR",
    "OPENCODE_ENABLE_EXPERIMENTAL_MODELS",
    "OPENCODE_DISABLE_PROJECT_CONFIG",
    "TYPESAFE_API_KEY",
    "ZAI_CODING_PLAN_API_KEY"
  ],
  "memory": "2048m",
  "cpus": 1.0,
  "pids_limit": 1024,
  "extra_data_volumes": {
    "pi": { "type": "bind", "source": "~/.pi", "target": "~/.pi" },
    "opencode": {
      "type": "bind",
      "source": "~/.config/opencode",
      "target": "~/.config/opencode"
    },
    "claude": { "type": "bind", "source": "~/.claude", "target": "~/.claude" },
    "claude-json": {
      "type": "bind",
      "source": "~/.claude.json",
      "target": "~/.claude.json"
    },
    "agents": { "type": "bind", "source": "~/.agents", "target": "~/.agents" },
    "config-cue": {
      "source": "~/.config/cue/",
      "target": "~/.config/cue/",
      "type": "bind",
      "mode": "rw"
    },
    "cue-platform": {
      "source": "~/code/palekiwi-labs/cue-platform/",
      "target": "~/code/palekiwi-labs/cue-platform/",
      "type": "bind",
      "mode": "rw"
    },
    "cue-store": {
      "source": "~/cue/",
      "target": "~/cue/",
      "type": "bind",
      "mode": "rw"
    },
    "vendor": {
      "source": "/home/pl/code/vendor/",
      "target": "/home/pl/code/vendor/",
      "type": "bind",
      "mode": "rw"
    }
  },
  "nix_extra_substituters": [
    "https://palekiwi.cachix.org",
    "https://cache.numtide.com"
  ],
  "nix_extra_trusted_public_keys": [
    "palekiwi.cachix.org-1:/S23j64quRTMpe+zteCPAd0p8fczVTWzOpV5mFoFOg8=",
    "niks3.numtide.com-1:DTx8wZduET09hRmMtKdQDxNNthLQETkc/yaX7M4qK0g="
  ],
  "memory": "2048m",
  "forbidden_paths": [".envrc"],
  "timezone": "Asia/Taipei"
}
